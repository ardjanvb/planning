@inherits LayoutComponentBase
@implements IDisposable
@inject SessionState Session
@inject NavigationManager Nav

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (!Session.IsAuthenticated && !IsLoginPage)
{
    <div class="content px-4 py-4">
        <MudAlert Severity="Severity.Info">U bent niet ingelogd. <MudLink Href="/login">Ga naar inloggen</MudLink>.</MudAlert>
    </div>
}
else if (IsLoginPage)
{
    @Body
}
else
{
    <div class="page @(_sidebarOpen ? "sidebar-open" : "sidebar-closed")">
        @if (_sidebarOpen)
        {
            <div class="sidebar-backdrop" @onclick="CloseSidebar"></div>
        }
        <div class="sidebar">
            <NavMenu OnToggle="ToggleSidebar" />
        </div>

        <main>
            <div class="top-row px-4 d-flex align-items-center gap-3">
                <button type="button" class="menu-toggle" @onclick="ToggleSidebar" aria-label="Menu" aria-expanded="@_sidebarOpen">
                    <span class="menu-toggle-bar"></span>
                    <span class="menu-toggle-bar"></span>
                    <span class="menu-toggle-bar"></span>
                </button>
                <div class="d-flex align-items-center gap-3 ms-auto">
                    <span class="text-muted small">@Session.DisplayName (@AppRoles.DisplayName(Session.Role))</span>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Logout">Uitloggen</MudButton>
                </div>
            </div>

            <article class="content px-4">
                @Body
            </article>
        </main>
    </div>
}

<div id="blazor-error-ui" data-nosnippet>
    Er is een onverwachte fout opgetreden.
    <a href="." class="reload">Herladen</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _sidebarOpen = true;
    private bool IsLoginPage => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("login", StringComparison.OrdinalIgnoreCase);

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;
    private void CloseSidebar() => _sidebarOpen = false;

    protected override void OnInitialized()
    {
        Session.Changed += OnChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private void Logout()
    {
        Session.Logout();
        Nav.NavigateTo("/login");
    }

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
