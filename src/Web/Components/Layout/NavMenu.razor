@implements IDisposable
@inject SessionState Session
@inject IJSRuntime JS

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Personeelsplanning</a>
    </div>
</div>

<button type="button" class="navbar-toggler" title="Menu sluiten" aria-label="Menu sluiten" @onclick="OnToggle"></button>

<div class="nav-scrollable" @onclick="CloseOnNarrow">
    <nav class="nav flex-column">
        <div class="nav-section-label px-3">Planning</div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Planningsmatrix
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="capaciteit">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Capaciteit
            </NavLink>
        </div>
        @if (Session.CanImport)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="import">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Import
                </NavLink>
            </div>
        }
        @if (Session.CanExport)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="export">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Export
                </NavLink>
            </div>
        }
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="versies">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Versies
            </NavLink>
        </div>

        @if (Session.CanManageMasterData)
        {
            <div class="nav-section-label px-3 mt-2">Beheer</div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="beheer/medewerkers">Medewerkers</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="beheer/werkplekken">Werkplekken</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="beheer/ploegen">Ploegen &amp; patronen</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="beheer/kwalificaties">Functies &amp; kwalificaties</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="beheer/kalender">Kalender</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="beheer/afwezigheid">Afwezigheid</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="beheer/audit">Wijzigingshistorie</NavLink>
            </div>
        }
    </nav>
</div>

@code {
    [Parameter] public EventCallback OnToggle { get; set; }

    protected override void OnInitialized() => Session.Changed += OnChanged;
    private void OnChanged() => InvokeAsync(StateHasChanged);

    private async Task CloseOnNarrow()
    {
        try
        {
            if (await JS.InvokeAsync<bool>("planningIsNarrow"))
                await OnToggle.InvokeAsync();
        }
        catch (JSException)
        {
            // Script not ready yet; leave the menu as-is.
        }
    }

    public void Dispose() => Session.Changed -= OnChanged;
}
